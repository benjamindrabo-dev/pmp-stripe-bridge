# Preparation only. Nothing in the current checkout reads these values yet.
# Operator flags are NOT evidence of approval from GoDaddy.
PMP_GODADDY_ENABLED=0
PMP_GODADDY_REVIEW_APPROVED=0
PMP_GODADDY_ACCEPTANCE_VERIFIED=0

# Obtain the real merchant IDs and authorize the app in the real GoDaddy/Poynt account.
# Never substitute the ordinary GoDaddy domain API key.
GODADDY_BUSINESS_ID=
GODADDY_STORE_ID=
GODADDY_APPLICATION_ID=
GODADDY_PRIVATE_KEY=

# Optional short-lived merchant access token for a controlled diagnostic.
# For ongoing use, use the authorized application/private-key flow above.
GODADDY_ACCESS_TOKEN=

# Generate privately in the deployment secret store; minimum 32 characters.
# Do not put an actual secret into this example or a Git commit.
GODADDY_WEBHOOK_SECRET=

# Proposed charge currency based on the existing Canadian bridge; verify it
# against the real GoDaddy store. This setting performs NO currency conversion.
GODADDY_CHARGE_CURRENCY=CAD
